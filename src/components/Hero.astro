---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import meImage from "@/assets/me.jpeg";
import Badge from "@/components/Badge.astro";
import SocialPill from "@/components/SocialPill.astro";
import GitHubIcon from "@/icons/GitHubIcon.astro";
import EmailIcon from "@/icons/EmailIcon.astro";
import LinkedInIcon from "@/icons/LinkedInIcon.astro";
import { SITE_EMAIL } from "@/data/site";
import { TAGS } from "@/data/projects";

const featured = await getEntry("projects", "dental-clinic");
---

<div class="grid gap-12 md:grid-cols-2 md:items-center">
  <div>
    <div class="flex gap-4 mb-6">
      <Image class="rounded-full size-16 object-cover" src={meImage} alt="Gino Lencina" loading="eager" />
      <a href="https://www.linkedin.com/in/ginolencina/" target="_blank" rel="noopener" class="flex justify-center items-center">
        <Badge>Disponible para trabajar</Badge>
      </a>
    </div>

    <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl dark:text-slate-100">
      Gino Lencina | Full Stack Developer
    </h1>
    <p class="mt-6 text-xl text-slate-800 dark:text-slate-300 [&>strong]:text-blue-800 dark:[&>strong]:text-blue-300 [&>strong]:font-semibold">
      <strong>Desarrollador Full Stack con Java, Spring Boot y React</strong>, de San Miguel, Buenos Aires, Argentina.
      Desarrollo aplicaciones web con foco en seguridad, pruebas y experiencia de usuario.
      En Dental Clinic rediseñé el flujo de login y lo respaldé con tests.
    </p>

    <nav aria-label="Contacto y perfiles" class="flex gap-4 mt-8 flex-wrap">
      <SocialPill href="https://www.linkedin.com/in/ginolencina/">
        <LinkedInIcon class="size-4 md:size-6" /> LinkedIn
      </SocialPill>
      <SocialPill href="https://github.com/GinoL221">
        <GitHubIcon class="size-4 md:size-6" /> GitHub
      </SocialPill>
      <SocialPill href={`mailto:${SITE_EMAIL}`}>
        <EmailIcon class="size-4 md:size-6" /> {SITE_EMAIL}
      </SocialPill>
    </nav>
  </div>

  {featured && !featured.data.draft && featured.data.tagline && (
    <aside aria-label="Proyecto destacado" class="rounded-xl border border-blue-200 bg-white p-6 shadow-lg dark:border-slate-600 dark:bg-slate-800">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-slate-100">{featured.data.title}</h2>
      <p class="mt-4 text-slate-700 dark:text-slate-300">Sistema de gestión para clínicas dentales.</p>
      <ul class="mt-5 flex flex-wrap gap-2" aria-label="Tecnologías">
        {featured.data.tags.map((key) => {
          const tag = TAGS[key as keyof typeof TAGS];
          return tag && <li class="rounded-full bg-blue-50 px-3 py-1 text-sm text-blue-900 dark:bg-slate-700 dark:text-blue-100">{tag.name}</li>;
        })}
      </ul>
      <div aria-hidden="true" class="ml-3 h-6 border-l border-blue-300 dark:border-slate-500"></div>
      <div class="border-t border-blue-200 pt-5 dark:border-slate-600">
        <h3 class="font-semibold text-slate-900 dark:text-slate-100">Decisión técnica</h3>
        <p class="mt-3 mb-4 text-slate-700 dark:text-slate-300">{featured.data.tagline}</p>
        <a href={`/projects/${featured.id}`} class="font-medium text-blue-800 underline underline-offset-4 hover:text-blue-600 focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1e40af] dark:focus-visible:outline-[#93c5fd] dark:text-blue-200 dark:hover:text-blue-100">
          Ver caso de estudio
        </a>
      </div>
    </aside>
  )}
</div>
