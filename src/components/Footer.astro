---
import { SITE_EMAIL } from "@/data/site";
const currentYear = new Date().getFullYear();
---

<footer
  class="m-4 px-4 md:px-0 mt-4 w-full mx-auto container lg:max-w-4xl md:max-w-2xl mb-10 flex justify-center"
>
  <div
    class="rounded-lg w-full max-w-screen-xl mx-auto flex flex-col items-center gap-3 md:flex-row md:justify-between py-4"
  >
    <ul
      class="flex flex-wrap justify-center items-center text-sm font-medium text-zinc-800/90 dark:text-white/90 md:order-2"
    >
      <li>
        <a href="/" class="hover:underline hover:text-[#1e40af] dark:hover:text-[#93c5fd] me-4 md:me-6">Inicio</a>
      </li>
      <li>
        <a id="contacto" href={`mailto:${SITE_EMAIL}`} class="hover:underline hover:text-[#1e40af] dark:hover:text-[#93c5fd]"
          >Contacto</a
        >
      </li>
    </ul>
    <span class="text-sm text-center md:text-left text-zinc-800/90 dark:text-zinc-200/90 md:order-1"
      >&copy; {currentYear}
      <a href="https://www.linkedin.com/in/ginolencina/" class="hover:underline hover:text-[#1e40af] dark:hover:text-[#93c5fd]">Gino</a>. Unos pocos
      derechos reservados.
    </span>
  </div>
</footer>
